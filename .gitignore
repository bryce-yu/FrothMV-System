# Python virtual environment
venv/

# Python cache
__pycache__/
*.pyc

# VS Code settings
.vscode/

# Local configuration
.env
config.local.json

# Local or generated dataset content
dataset/debug/
dataset/development/
dataset/yolo/images/
dataset/pipeline_validation_images/

# Training outputs
runs/

# Trained model weights
models/*.pt

# Ignore generated results by default
results/*

# Keep selected lightweight result folders
!results/dataset_checks/
!results/dataset_checks/**

!results/mask_metrics/
!results/mask_metrics/**

# Keep lightweight controlled experiment outputs
!results/yolo_experiments*/
!results/yolo_experiments*/**/

# Re-ignore large generated experiment outputs
results/yolo_experiments*/**/predicted_masks/
results/yolo_experiments*/**/visualisations/

# Keep experiment tables and representative cases
!results/yolo_experiments*/**/*.csv
!results/yolo_experiments*/**/representative_cases/
!results/yolo_experiments*/**/representative_cases/**

# Keep lightweight YOLO diagnostic outputs
!results/yolo_diagnostics/
!results/yolo_diagnostics/**/
!results/yolo_diagnostics/**/*.csv
!results/yolo_diagnostics/representative_cases/
!results/yolo_diagnostics/representative_cases/**

# Ignore generated pipeline run outputs
results/pipeline_runs/*

# Keep lightweight pipeline summary tables if required
!results/pipeline_runs/
!results/pipeline_runs/*.csv
!results/pipeline_runs/*.json

# Ignore temporary pipeline test images
dataset/pipeline_test_images/
dataset/pipeline_rep_images/
dataset/invalid_input_test_images/
dataset/normal_operation_test/
dataset/presentation_images_v1/
dataset/presentation_images/


# Keep lightweight pipeline soft sensor analysis outputs
!results/soft_sensor_analysis/
!results/soft_sensor_analysis/*.csv
!results/soft_sensor_analysis/*.json

# Ignore private key
certificates/*_key.pem

# Ignore logs
/logs/