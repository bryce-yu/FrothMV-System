# Python virtual environment
venv/

# Python cache
__pycache__/
*.pyc

# Ignore generated results by default
results/*

# Keep selected lightweight result folders
!results/dataset_checks/
!results/dataset_checks/**
!results/mask_metrics/
!results/mask_metrics/**

# VS Code settings
.vscode/

# Local or generated dataset content
dataset/debug/
dataset/development/
dataset/yolo/images/

# Local configuration
.env
config.local.json

# Python
__pycache__/
*.pyc

# Training outputs
runs/

# Trained model weights
models/*.pt

# Ignore large YOLO evaluation outputs
results/yolo_evaluation/predicted_masks/
results/yolo_evaluation/visualisations/

# Allow lightweight evaluation tables
!results/yolo_evaluation/
!results/yolo_evaluation/*.csv
